rules_version = '2';

// These rules — not the admin UI — are what actually protect the data. The site
// is a static export, so anyone can read the JavaScript and call Firestore
// directly. Every rule below is enforced on Google's servers.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in account is an admin if it has a document in `admins`,
    // keyed by its Firebase Auth UID.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The admin roster.
    // A signed-in user may read their OWN entry — that is how the editor knows
    // whether to show itself. Nobody can list the roster or write to it from a
    // browser; admins are added in the Firebase console (see SETUP.md).
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // Blog posts.
    // Anyone may read a published post. Drafts, and all writes, are admin-only.
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Contact form submissions.
    // Anyone may send one (that is the point of a contact form), but the shape
    // and size are constrained so the collection can't be used as free storage.
    // Only admins can read, update or delete them.
    match /messages/{messageId} {
      allow create: if isWellFormedMessage();
      allow read, update, delete: if isAdmin();
    }

    function isWellFormedMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(
               ['name', 'email', 'organisation', 'topic', 'message', 'createdAt', 'read']
             )
        && d.name is string       && d.name.size() > 0   && d.name.size() <= 120
        && d.email is string      && d.email.size() > 3   && d.email.size() <= 200
        && d.organisation is string && d.organisation.size() <= 160
        && d.topic is string      && d.topic.size() <= 80
        && d.message is string    && d.message.size() >= 10 && d.message.size() <= 4000
        && d.read == false
        && d.createdAt == request.time;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
