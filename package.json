{
  "name": "hailstrum-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulate": "firebase emulators:start --only auth,firestore --project demo-hailstrum",
    "seed": "node scripts/seed-emulator.mjs",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:rules": "node scripts/test-rules.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.31.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Hailstrum \u2014 autonomous drone logistics. Marketing site plus a Firebase-backed admin area for publishing updates."
}
